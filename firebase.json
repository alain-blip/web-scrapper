{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "node \"$RESOURCE_DIR/copy-scraper.mjs\"",
      "node \"$RESOURCE_DIR/generate-manifest.mjs\""
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "app-consultation",
    "ignore": ["firebase.json", "**/.*"]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "auth": {
      "port": 9099
    }
  }
}

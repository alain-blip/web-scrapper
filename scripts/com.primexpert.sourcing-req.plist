<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.primexpert.sourcing-req</string>

  <!-- Lance le wrapper (sur disque interne → pas de blocage TCC) qui exécute
       src/local/sourcingQuotidien.ts -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/alainst-jean/05_WEBSCRAPPER/code/scripts/run-sourcing-req.sh</string>
  </array>

  <!-- Compte de service dédié (roles/datastore.user, primexpert-msss-registre),
       pas l'ADC utilisateur : le SDK Admin (@google-cloud/firestore) lit
       GOOGLE_APPLICATION_CREDENTIALS avant l'ADC — zéro changement de code
       côté sourcingInverse.ts/sourcingQuotidien.ts. Tue invalid_rapt (ce
       jeton de compte de service ne demande jamais de réauth interactive). -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>GOOGLE_APPLICATION_CREDENTIALS</key>
    <string>/Users/alainst-jean/.config/primexpert/sa-sourcing-req.json</string>
  </dict>

  <!-- Tous les jours à 5h00. Si la machine dort à 5h00, launchd exécute au
       réveil suivant ; le réveil pmset de 4h58 garantit le déclenchement. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- Sortie brute de launchd (le log détaillé est écrit par le wrapper dans
       ~/Library/Logs/sourcing-req.log). -->
  <key>StandardOutPath</key>
  <string>/Users/alainst-jean/Library/Logs/sourcing-req.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alainst-jean/Library/Logs/sourcing-req.err.log</string>
</dict>
</plist>
